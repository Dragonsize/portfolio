{
  "name": "security-portfolio-labs",
  "version": "2.0.0",
  "private": true,
  "description": "Public security portfolio and deterministic educational security labs",
  "type": "module",
  "scripts": {
    "start": "node scripts/local-server.js",
    "start:labs": "node scripts/local-server.js labs",
    "start:portfolio": "node scripts/local-server.js portfolio",
    "dev": "npm run dev:portfolio",
    "dev:portfolio": "vercel dev apps/portfolio --listen 3000",
    "dev:labs": "vercel dev apps/labs --listen 3001",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-syntax.js",
    "deploy:portfolio": "vercel --prod apps/portfolio",
    "deploy:labs": "vercel --prod apps/labs"
  }
}
